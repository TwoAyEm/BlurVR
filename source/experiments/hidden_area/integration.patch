+bool XrRuntimeHiddenAreaMesh(int eye, std::vector<float>& xy)
+{
+    xy.clear();
+    if (!g_xr.getVisibilityMask || g_xr.session == XR_NULL_HANDLE || eye < 0 || eye > 1)
+        return false;
+    XrVisibilityMaskKHR mask = {XR_TYPE_VISIBILITY_MASK_KHR};
+    XrResult result = g_xr.getVisibilityMask(g_xr.session, XR_VIEW_CONFIGURATION_TYPE_PRIMARY_STEREO, (uint32_t)eye, XR_VISIBILITY_MASK_TYPE_HIDDEN_TRIANGLE_MESH_KHR, &mask);
+    if (XR_FAILED(result) || mask.vertexCountOutput == 0 || mask.indexCountOutput < 3) {
+        Log("OpenXR: the hidden-area mesh of eye %d: %s (%u vertices, %u indices)", eye, XR_FAILED(result) ? ResultText(result) : "none", (unsigned)mask.vertexCountOutput, (unsigned)mask.indexCountOutput);
+        return false;
+    }
+    std::vector<XrVector2f> vertices(mask.vertexCountOutput);
+    std::vector<uint32_t> indices(mask.indexCountOutput);
+    mask.vertexCapacityInput = mask.vertexCountOutput;
+    mask.vertices = vertices.data();
+    mask.indexCapacityInput = mask.indexCountOutput;
+    mask.indices = indices.data();
+    result = g_xr.getVisibilityMask(g_xr.session, XR_VIEW_CONFIGURATION_TYPE_PRIMARY_STEREO, (uint32_t)eye, XR_VISIBILITY_MASK_TYPE_HIDDEN_TRIANGLE_MESH_KHR, &mask);
+    if (XR_FAILED(result))
+        return false;
+    for (uint32_t i = 0; i + 2 < mask.indexCountOutput; i += 3)
+        for (int k = 0; k < 3; k++) {
+            const uint32_t index = indices[i + k];
+            if (index >= mask.vertexCountOutput)
+                return false;
+            xy.push_back(vertices[index].x);
+            xy.push_back(vertices[index].y);
+        }
+    Log("OpenXR: the hidden-area mesh of eye %d: %u vertices, %u triangles", eye, (unsigned)mask.vertexCountOutput, (unsigned)(mask.indexCountOutput / 3));
+    return true;
+}
